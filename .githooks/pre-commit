#!/usr/bin/env bash

set -euo pipefail

current_branch=$(git branch --show-current)

if [[ -z "$current_branch" ]]; then
    echo "Refusing to commit from a detached HEAD. Switch to a feature branch first."
    exit 1
fi

if [[ "$current_branch" == "main" ]]; then
    echo "Refusing to commit on main. Switch to a feature branch first."
    exit 1
fi
